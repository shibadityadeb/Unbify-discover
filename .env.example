# required
DATABASE_URL=
APIFY_TOKEN=
LITELLM_KEY=

# optional — see README: the system degrades honestly without these
APIFY_WEBHOOK_SECRET=
APP_URL=
SESSION_SECRET=

# feature flags
WORLD_INTELLIGENCE_ENABLED=1
APIFY_INGESTION_ENABLED=0
COMMUNITY_SIGNALS_ENABLED=0
TARGETED_MARKET_REFRESH_ENABLED=1
MARKET_BASED_RANKING_ENABLED=1

# Google sign-in (optional): OAuth Web client ID from console.cloud.google.com
GOOGLE_CLIENT_ID=

# live market discovery (server-side; token never reaches the browser)
# APIFY_JOBS_ACTOR defaults to fantastic-jobs~career-site-job-listing-api
APIFY_JOBS_ACTOR=
LIVE_MARKET_ENABLED=1
